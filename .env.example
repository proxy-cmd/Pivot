VITE_API_URL=http://localhost:8000
APP_ENV=development

# Backend-only secrets. Copy to backend/.env; never expose these in Vite variables.
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:5432/pivot
POSTGRES_DB=pivot
POSTGRES_USER=
POSTGRES_PASSWORD=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=pivot-api
JWT_AUDIENCE=pivot-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_ROWS=500000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Local development only. Production must use STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/files
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
